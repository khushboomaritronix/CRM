# ─── Django ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-in-production-with-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── Email ────────────────────────────────────────────────────
# Option A: Console backend - shows credentials in terminal (good for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Option B: Gmail SMTP - uncomment and use an App Password (NOT your Gmail password)
# Get App Password: Google Account → Security → 2-Step Verification → App passwords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

DEFAULT_FROM_EMAIL=noreply@crm.com

# ─── Frontend (used in welcome emails) ────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Redis (optional, for Celery background tasks) ────────────
REDIS_URL=redis://localhost:6379/0
