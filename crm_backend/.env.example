# CRM_V3 Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env with real secrets!

# ─── Django Settings ──────────────────────────────────────────────────────────
# Use config.settings.development for development (has DEBUG=True, CORS open)
# Use config.settings.production for production (secure defaults)
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key: Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-50-character-random-secret-key-required
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=crm_v3
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (Caching & Celery) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS Settings ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ─── Email Configuration ──────────────────────────────────────────────────────
# Development: Use console backend (emails printed to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: Use Gmail or other SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=app-specific-password-not-gmail-password

DEFAULT_FROM_EMAIL=noreply@crm.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator

# ─── Microsoft Graph (app email: account-created, password-changed, RFQ) ─────
# Actual app emails (not Django's own error mail) are sent via Microsoft
# Graph, not the EMAIL_* settings above — see apps/notifications/graph_email.py.
# Needs an Azure AD app registration with Mail.Send APPLICATION permission
# (admin-consented) on the mailbox named in DEFAULT_FROM_EMAIL.
# Leave these blank in local dev — email sends will just fail gracefully and
# log to EmailLog/console instead of crashing anything.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ─── JWT Configuration ────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME=28800  # 8 hours (in seconds)
REFRESH_TOKEN_LIFETIME=604800  # 7 days (in seconds)

# ─── Celery (Background Tasks) ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Error Tracking (Sentry) ──────────────────────────────────────────────────
# Optional: Get free account at https://sentry.io
SENTRY_DSN=

# ─── Security Settings (Production Only) ──────────────────────────────────────
SECURE_SSL_REDIRECT=False  # Set to True in production
SESSION_COOKIE_SECURE=False  # Set to True in production
CSRF_COOKIE_SECURE=False  # Set to True in production
SECURE_HSTS_SECONDS=0  # Set to 31536000 in production
