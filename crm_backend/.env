# Microsoft Graph — app email (account-created, password-changed, RFQ notifications)
# Needs an Azure AD app registration with Mail.Send APPLICATION permission on
# the mailbox named in DEFAULT_FROM_EMAIL above. NOTE: DEFAULT_FROM_EMAIL is
# currently a Gmail address — Graph's sendMail only works against a real
# Microsoft 365/Outlook mailbox, so you'll likely want to change
# DEFAULT_FROM_EMAIL to that mailbox's address once Graph is wired up.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:3000

# CORS - Restrict to production domain only
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis (Caching & Celery)
REDIS_URL=redis://localhost:6379/0
