# CRM_V3 — QAT environment template
# On the QAT server, copy this to .env and fill in the real values.
# NEVER commit the real .env — see the note at the bottom of this file.

# ─── Django Settings ──────────────────────────────────────────────────────────
# QAT should run the same hardened settings as production.
DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=replace-with-a-real-random-secret-key
DEBUG=False
ENVIRONMENT=qat

# The QAT domain(s) this backend is served from
ALLOWED_HOSTS=mtxcrm-qat.maritronix.in

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=crm_qat
DB_USER=replace-with-qat-db-user
DB_PASSWORD=replace-with-qat-db-password
DB_HOST=replace-with-qat-db-host
DB_PORT=5432

# ─── Redis (Caching & Celery) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS / CSRF — the frontend origin(s) allowed to call this API ───────────
CORS_ALLOWED_ORIGINS=https://mtxcrm-qat.maritronix.in
CSRF_TRUSTED_ORIGINS=https://mtxcrm-qat.maritronix.in
FRONTEND_URL=https://mtxcrm-qat.maritronix.in

# ─── Email Configuration ──────────────────────────────────────────────────────
# EMAIL_* below is only for Django's own error mail (mail_admins in the
# logging config) — actual app emails (account-created, password-changed,
# RFQ notifications) go through Microsoft Graph, see the section below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-sender@yourdomain.com
EMAIL_HOST_PASSWORD=replace-with-app-specific-password

DEFAULT_FROM_EMAIL=noreply@maritronix.in
ADMIN_EMAIL=replace-with-admin@maritronix.in
ADMIN_NAME=Administrator

# ─── Microsoft Graph (app email: account-created, password-changed, RFQ) ─────
# Azure AD app registration credentials — the app registration needs
# Mail.Send APPLICATION permission (admin-consented) on the mailbox named
# in DEFAULT_FROM_EMAIL above.
MS_TENANT_ID=replace-with-azure-tenant-id
MS_CLIENT_ID=replace-with-azure-app-client-id
MS_CLIENT_SECRET=replace-with-azure-app-client-secret

# ─── JWT Configuration ────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME=28800  # 8 hours (in seconds)
REFRESH_TOKEN_LIFETIME=604800  # 7 days (in seconds)

# ─── Celery (Background Tasks) ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Error Tracking (Sentry) ──────────────────────────────────────────────────
SENTRY_DSN=

# ─── Security (already enforced by config.settings.production, no need to
# ─── set these — listed here only for reference) ─────────────────────────────
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# IMPORTANT: crm_backend/.env is currently committed to git with real secrets
# (SECRET_KEY, DB_PASSWORD, EMAIL_HOST_PASSWORD). This QAT .env should NOT be
# added to the repo the same way — keep it only on the QAT server itself, or
# in your deployment platform's secret manager.
